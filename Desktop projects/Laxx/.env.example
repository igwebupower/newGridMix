# Laxx Meditate -- API Keys
# Copy this file to .env and fill in your keys
# NEVER commit the .env file to git

# Suno AI (for audio generation)
# Sign up at https://sunoapi.org/ and get your API key
SUNO_API_KEY=your_suno_api_key_here

# Runway ML (for video clip generation)
# Sign up at https://dev.runwayml.com/ and get your API secret
RUNWAYML_API_SECRET=your_runway_api_secret_here

# YouTube Data API (uses OAuth -- no key needed here)
# Place client_secrets.json in the project root instead
# Get it from https://console.cloud.google.com/
